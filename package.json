{
  "$schema": "./node_modules/@sargonpiraev/eslint-config/build/schemas/project__package.json",
  "name": "seokit",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{mjs,cjs,js,ts,tsx,md,json,yaml,yml}\"",
    "lint": "turbo run lint",
    "npm:install": "npm install",
    "prepare": "lefthook install",
    "pulumi:preview": "npm --prefix pulumi run preview",
    "pulumi:up": "npm --prefix pulumi run up",
    "test": "npm test -w @sargonpiraev/seokit && npm run test:pulumi",
    "test:build": "npm run build",
    "test:check-types": "turbo run check-types",
    "test:configlint": "alint check -c .alint.configlint.yaml",
    "test:eslint": "eslint .",
    "test:format": "prettier --check \"**/*.{mjs,cjs,js,ts,tsx,md,json,yaml,yml}\"",
    "test:fslint": "alint check -c .alint.fslint.yaml",
    "test:pulumi": "npm ci --prefix pulumi && npm --prefix pulumi run test:pulumi",
    "test:spec": "npm run build -w seokit-webapp && npm run test:spec -w seokit-webapp",
    "test:spec:analytics": "npm run build -w seokit-webapp && npm run test:spec:analytics -w seokit-webapp",
    "test:spec:feat": "npm run build -w seokit-webapp && npm run test:spec:feat -w seokit-webapp",
    "test:spec:perf": "npm run build -w seokit-webapp && npm run test:spec:perf -w seokit-webapp",
    "test:spec:seokit": "npm run build -w seokit-webapp && npm run test:spec:seokit -w seokit-webapp",
    "test:spec:visual": "bash scripts/pw-visual-docker.sh",
    "test:spec:visual:update": "bash scripts/pw-visual-docker.sh --update-snapshots",
    "test:unit": "turbo run test:unit"
  },
  "overrides": {
    "next": "16.2.11"
  },
  "devDependencies": {
    "@asamarts/alint": "^0.15.2",
    "@commitlint/cli": "21.2.2",
    "@sargonpiraev/commitlint-config": "1.2.0",
    "@sargonpiraev/configlint-config": "^0.0.0",
    "@sargonpiraev/eslint-config": "^1.9.0",
    "@sargonpiraev/fslint-config": "^0.0.1",
    "@sargonpiraev/lefthook-config": "0.0.1",
    "@sargonpiraev/prettier-config": "1.3.0",
    "@sargonpiraev/tsconfig": "1.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "semantic-release": "^25.0.2",
    "turbo": "^2.10.3",
    "typescript": "5.9.2"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@asamarts/alint@0.15.2": true
  }
}
