{
  "name": "seokit-webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-next.mjs 4100",
    "build": "next build --webpack",
    "start": "next start -p 4100",
    "test": "npm run build && npm run test:spec && npm run test:visual",
    "test:functional": "playwright test --project=functional",
    "test:seo": "playwright test --project=seo",
    "test:analytics": "playwright test --project=analytics",
    "test:visual": "playwright test --project=visual --project=visual-mobile",
    "test:spec": "playwright test --project=functional --project=seo --project=analytics",
    "test:spec:cov": "E2E_COVERAGE=true npm run test:spec",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sargonpiraev/seokit": "*",
    "@tailwindcss/postcss": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@repo/typescript-config": "*",
    "@types/node": "^25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "nextcov": "^1.5.1",
    "typescript": "5.9.2"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.2.10",
    "@parcel/watcher-linux-x64-glibc": "2.5.6",
    "@swc/core-linux-x64-gnu": "1.15.43"
  }
}
