{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/*.seo.spec.ts",
    "**/*.functional.spec.ts",
    "**/*.analytics.spec.ts",
    "**/*.visual.spec.ts",
    "playwright.config.ts",
    "e2e/**",
    "src/test/**"
  ]
}
