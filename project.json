{
  "name": "seokit",
  "$schema": "../schema/project__project.json",
  "projectType": "library",
  "tags": [
    "shared",
    "seo",
    "type:lib",
    "stack:playwright",
    "status:active"
  ],
  "metadata": {
    "description": "Playwright SEO matchers (toHaveMetadata, toHaveJsonLd)",
    "technologies": [
      "playwright",
      "typescript",
      "turbo"
    ]
  },
  "targets": {
    "test": {
      "cache": false,
      "command": "npm run test",
      "options": {
        "cwd": "seokit"
      }
    },
    "lint": {
      "cache": false,
      "command": "npm run lint",
      "options": {
        "cwd": "seokit"
      }
    },
    "check-types": {
      "cache": false,
      "command": "npm run check-types",
      "options": {
        "cwd": "seokit"
      }
    },
    "build": {
      "cache": false,
      "command": "npm run build",
      "options": {
        "cwd": "seokit"
      }
    },
    "test:unit": {
      "cache": false,
      "command": "npm run test:unit",
      "options": {
        "cwd": "seokit"
      }
    },
    "test:lint": {
      "cache": false,
      "command": "npm run test:lint",
      "options": {
        "cwd": "seokit"
      }
    },
    "test:types": {
      "cache": false,
      "command": "npm run test:types",
      "options": {
        "cwd": "seokit"
      }
    }
  }
}
